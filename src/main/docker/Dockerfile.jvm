# Imagen de despliegue para el módulo de identidad.
# Construir desde la raíz del módulo:
#   .\gradlew.bat build -x test
#   docker build -f src/main/docker/Dockerfile.jvm -t modulo-validar .
FROM eclipse-temurin:25-jre-alpine

LABEL org.opencontainers.image.title="Sistema Forense - Modulo A: Identidad y Autenticacion" \
      org.opencontainers.image.description="Microservicio de autenticacion, validacion de identidad y emision de JWT con Azure Key Vault" \
      org.opencontainers.image.version="1.0.0" \
      org.opencontainers.image.vendor="Universidad Central del Ecuador - Proyecto de Titulacion" \
      standards.microprofile="MicroProfile 6.0 (Config, Rest Client, Health, JWT, Fault Tolerance)"

ENV LANGUAGE='en_US:en'
ENV JAVA_OPTS='-Dquarkus.http.host=0.0.0.0 -Djava.util.logging.manager=org.jboss.logmanager.LogManager'

RUN addgroup -S quarkus && adduser -S quarkus -G quarkus

WORKDIR /deployments

COPY --chown=quarkus:quarkus build/quarkus-app/lib/ /deployments/lib/
COPY --chown=quarkus:quarkus build/quarkus-app/*.jar /deployments/
COPY --chown=quarkus:quarkus build/quarkus-app/app/ /deployments/app/
COPY --chown=quarkus:quarkus build/quarkus-app/quarkus/ /deployments/quarkus/

USER quarkus

EXPOSE 8080
ENV JAVA_APP_JAR='/deployments/quarkus-run.jar'

ENTRYPOINT ["sh", "-c", "exec java $JAVA_OPTS -jar /deployments/quarkus-run.jar"]
